{
  "name": "stepfund",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage --solcoverjs .solcover.cjs",
    "test:domain": "tsx --test test-domain/*.test.ts",
    "chain": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy-release.cjs --network sepolia",
    "zk:build": "node scripts/build-zk.cjs",
    "zk:check": "node scripts/check-zk.cjs",
    "release:check": "node scripts/release-check.cjs",
    "typecheck": "tsc --noEmit",
    "build:portable": "vite build --config portable.vite.config.ts",
    "package:windows": "node scripts/package-windows.cjs",
    "verify:sepolia": "hardhat run scripts/verify.cjs --network sepolia",
    "export:contracts": "node scripts/export-contracts.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@metamask/connect-evm": "2.1.1",
    "@shadcn/react": "^0.3.0",
    "@storacha/client": "2.1.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "ethers": "6.16.0",
    "fflate": "0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "multiformats": "13.4.2",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "poseidon-lite": "0.3.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "snarkjs": "0.7.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@openzeppelin/contracts": "5.4.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "chai": "4.5.0",
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "dotenv": "16.6.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "hardhat": "2.28.0",
    "json-rpc-2.0": "1.7.1",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "solc": "0.8.30",
    "solidity-coverage": "0.8.17",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
